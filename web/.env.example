# ─── Salin file ini menjadi .env.local ───────────────────────────────────────
# cp .env.example .env.local
# Lalu isi dengan nilai dari dashboard Supabase kamu:
# https://supabase.com/dashboard/project/_/settings/api

# URL project Supabase kamu
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key (aman untuk diekspos di frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JANGAN PERNAH taruh Service Role Key di sini! ───────────────────────────
# Service role key hanya untuk server-side / Edge Functions
