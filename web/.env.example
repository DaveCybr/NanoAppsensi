# ============================================================
# HR SYSTEM — Environment Variables
# Copy file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke git
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Ambil dari: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — HANYA untuk server-side, JANGAN expose ke client
# Ambil dari: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Face++ ────────────────────────────────────────────────
# Ambil dari: https://console.faceplusplus.com
FACEPP_API_KEY=your_facepp_api_key
FACEPP_API_SECRET=your_facepp_api_secret
# FaceSet token — buat via Face++ API sekali saja
FACEPP_FACESET_TOKEN=your_faceset_token

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HR System

# ── VPS Deployment ────────────────────────────────────────
# PORT=3000
# NODE_ENV=production
